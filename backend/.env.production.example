APP_NAME=Social
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=social
DB_USERNAME=
DB_PASSWORD=

SANCTUM_EXPIRATION=43200
CORS_ALLOWED_ORIGINS=https://app.example.com

STRIPE_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave empty. Admin sign-in uses the TOTP secret generated by DemoAccountsSeeder, which is not for production.
ADMIN_DEMO_OTP=

CACHE_STORE=database
QUEUE_CONNECTION=database
# The API does not use server sessions. array avoids a sessions table and raw IP storage.
SESSION_DRIVER=array

# Set serpapi and a real key before launch. An empty key makes search return 503.
COMPARE_PROVIDER=serpapi
SERPAPI_API_KEY=
COMPARE_CACHE_TTL=600
COMPARE_TIMEOUT=4
AFFILIATE_QUERY_PARAM=tag
AFFILIATE_ID=

COMMERCE_PURCHASES=false

AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Social
MAIL_ENCRYPTION=tls

SENTRY_LARAVEL_DSN=
