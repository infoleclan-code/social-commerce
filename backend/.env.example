APP_NAME=Social
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=social
DB_USERNAME=
DB_PASSWORD=

# Minutes until a newly issued Sanctum token expires. 43200 is 30 days.
SANCTUM_EXPIRATION=43200

# Comma-separated browser origins. Do not use *.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

STRIPE_SECRET=
STRIPE_KEY=
STRIPE_WEBHOOK_SECRET=

# Local demo only. A second factor for the seeded admin when an authenticator is not handy.
# Leave empty in production. A real TOTP code from the admin secret always works.
ADMIN_DEMO_OTP=

CACHE_STORE=database
QUEUE_CONNECTION=database
# The API does not use server sessions. array avoids a sessions table and raw IP storage.
SESSION_DRIVER=array

LOG_LEVEL=debug

# Price comparison. fake is deterministic and needs no key. serpapi uses Google Shopping
# and returns 503 when SERPAPI_API_KEY is empty (it does not fall back to fake prices).
COMPARE_PROVIDER=fake
SERPAPI_API_KEY=
COMPARE_CACHE_TTL=600
COMPARE_TIMEOUT=12
AFFILIATE_QUERY_PARAM=
AFFILIATE_ID=

# In-app checkout, cart, auctions, gifts, and payouts. Off for the launch build.
COMMERCE_PURCHASES=false

# Web session cookie. Use none (which forces Secure) when the site and API are different hosts.
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Social

SENTRY_LARAVEL_DSN=
