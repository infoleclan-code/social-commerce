# Public client config. EXPO_PUBLIC_ values are compiled into the app.
# Leave the API key empty. The model key belongs on the server.
EXPO_PUBLIC_AI_VISION_ENDPOINT=
EXPO_PUBLIC_AI_API_KEY=
EXPO_PUBLIC_VECTOR_DB_ENDPOINT=

# Laravel API base URL. A phone on your Wi-Fi needs the computer's LAN IP (http://192.168.x.x:8000), not 127.0.0.1.
EXPO_PUBLIC_API_URL=
# Stripe: the API serves the publishable key with /payment-methods/*. Set this only for an API that does not.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Apple Pay: your Apple merchant ID. Add the same value as "merchantIdentifier" to the Stripe plugin in app.json.
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=
# Two-letter country of the Stripe account (Apple Pay / Google Pay sheets).
EXPO_PUBLIC_STRIPE_MERCHANT_COUNTRY=US
# Business name shown on the payment sheet. Defaults to the app name.
EXPO_PUBLIC_MERCHANT_DISPLAY_NAME=
# Development builds only: a Sanctum token used when nothing is stored yet.
# Sign-in replaces it. Never set it in an EAS production profile.
EXPO_PUBLIC_DEV_AUTH_TOKEN=
